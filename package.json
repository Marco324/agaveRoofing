{
  "name": "agave-alerta-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema AgaveAlerta — Gestión de Inspecciones de Techo para Agave Roofing (San Antonio, TX)",
  "type": "module",
  "scripts": {
    "api": "node --experimental-strip-types --experimental-sqlite api/src/server.ts",
    "api:demo": "node --experimental-strip-types --experimental-sqlite scripts/api-demo.mjs",
    "start": "node --experimental-strip-types --experimental-sqlite api/src/server.ts",
    "seed": "node --experimental-strip-types --experimental-sqlite api/src/seed.ts",
    "seed:demo": "node --experimental-strip-types --experimental-sqlite api/src/seed.ts --demo",
    "test": "node scripts/test-api.mjs",
    "test:auth": "node scripts/test-api.mjs auth",
    "test:fecha": "node scripts/test-api.mjs fecha_referencia",
    "test:e07": "node scripts/test-api.mjs agenda",
    "test:e08-e09": "node scripts/test-api.mjs e08_e09",
    "test:e10-e11": "node scripts/test-api.mjs e10_e11",
    "test:fcm": "node scripts/test-api.mjs fcm",
    "test:pasadas": "node scripts/test-api.mjs citas_pasadas",
    "dev": "node --experimental-strip-types --experimental-sqlite scripts/dev.mjs",
    "preview": "node --experimental-strip-types --experimental-sqlite scripts/dev.mjs --preview",
    "build:ui": "tailwindcss -i shared/ui/tailwind.css -o shared/ui/utilities.css --minify",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19",
    "@playwright/test": "^1.58.2"
  }
}
